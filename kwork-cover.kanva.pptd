version: v2
title: Обложка Kwork — сайт Лак и точка
size: [1100, 740]
customFonts:
  - family: Onest
    src: "https://fonts.googleapis.com/css2?family=Onest"
  - family: Tenor Sans
    src: "https://fonts.googleapis.com/css2?family=Tenor+Sans"
theme:
  colors:
    bg: "#f3f3ee"
    ink: "#1e221f"
    soft: "#5b625b"
    accent: "#4f6b55"
    card: "#ffffff"
  textStyles:
    kicker:
      fontSize: 15
      fontFamily: Onest
      color: "$accent"
      bold: true
      letterSpacing: 3
    body:
      fontSize: 17
      fontFamily: Onest
      color: "$soft"
      lineHeight: 1.55
pages:
  - pages/1_cover.page
